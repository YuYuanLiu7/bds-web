# ============================================================
# BDS 網站環境變數範本
# 複製本檔為 .env.local 後填入實際值（.env.local 不會被 git 追蹤）
# ============================================================

# --- 網站基本 ---
# 正式網域（用於 NextAuth 回呼、金流 ReturnURL/NotifyURL、信件連結）
NEXTAUTH_URL=https://your-domain.com
# NextAuth 加密用隨機字串，可用：openssl rand -base64 32
NEXTAUTH_SECRET=請填入夠長的隨機字串

# --- Supabase（資料庫）---
# Supabase 專案 URL 與金鑰，取自 Supabase Dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...（anon public 金鑰）
# service_role 金鑰（標示 secret）。啟用 RLS 後伺服器端以此金鑰存取資料庫。
# ⚠️ 僅伺服器可見、絕不可加 NEXT_PUBLIC_ 前綴、絕不可外洩到瀏覽器或前端程式碼。
SUPABASE_SERVICE_ROLE_KEY=sb_secret_...（或 eyJ... service_role 金鑰）
# （可選）資料庫直連字串，僅供 `npm run setup -- --migrate` 自動建置資料表使用。
# 取自 Supabase → Project Settings → Database → Connection string（URI），含密碼。
# 不設定也可，改為手動於 SQL Editor 貼上 db/*.sql。
SUPABASE_DB_URL=postgresql://postgres:[密碼]@db.xxxxxxxx.supabase.co:5432/postgres

# --- PayUni 金流（伺服器端，用於建立訂單與加密簽章）---
PAYUNI_MERID=你的商店代號
PAYUNI_HASH_KEY=你的 HashKey（AES 金鑰，長度需正確）
PAYUNI_HASH_IV=你的 HashIV
# 前端送出表單用的 UPP 端點：
#   測試：https://sandbox-api.payuni.com.tw/api/upp
#   正式：https://api.payuni.com.tw/api/upp
NEXT_PUBLIC_PAYUNI_UPP_URL=https://sandbox-api.payuni.com.tw/api/upp
# 前端僅供顯示用的商店代號（非機敏）
NEXT_PUBLIC_PAYUNI_MERID=你的商店代號

# 是否在「正式環境」開放模擬付款端點（僅供測試，正式上線請勿設為 true）
# 開發環境（NODE_ENV=development）一律可用，不需設定此項
ENABLE_PAYMENT_SIMULATION=false

# --- Bunny.net 影片串流與防盜（伺服器端，皆勿加 NEXT_PUBLIC_）---
# Stream Library ID 與 Token Authentication Key，取自 Bunny → Stream → 你的影片庫 → API / Security
# 需在該影片庫的 Security 開啟「Embed View Token Authentication」，播放網址才會帶 Token 防盜
BUNNY_STREAM_LIBRARY_ID=你的_Stream_Library_ID
BUNNY_TOKEN_AUTH_KEY=你的_Token_Authentication_Key
# 影片「上傳」用的 API 金鑰（AccessKey），取自 Bunny → Stream → 你的影片庫 → API 分頁。
# ⚠️ 與上面播放防盜用的 BUNNY_TOKEN_AUTH_KEY 是「不同」的兩把鑰匙。
# 僅 scripts/bunny-upload.mjs 批次上傳影片時需要；網站本身運作不需要它。
BUNNY_STREAM_API_KEY=你的_Stream_影片庫_API_Key
# （選用）若改用 CDN Pull Zone 直送 HLS .m3u8，填入 CDN 主機名
BUNNY_CDN_HOSTNAME=

# --- Resend（寄送 Email：購買成功通知、聯絡表單）---
# 取自 https://resend.com → API Keys
RESEND_API_KEY=re_...
# 寄件人地址。使用已驗證網域（如 no-reply@your-domain.com）；
# 未驗證時可暫用 onboarding@resend.dev（僅能寄到下方測試收件者）
RESEND_FROM_EMAIL=no-reply@your-domain.com
# 使用 onboarding 沙盒網域時的測試收件信箱（僅開發/測試需要）
RESEND_TEST_RECIPIENT=your-verified@email.com
# 聯絡我們表單的收件信箱（未設定時退回 RESEND_TEST_RECIPIENT 或預設客服信箱）
CONTACT_TO_EMAIL=support@your-domain.com
